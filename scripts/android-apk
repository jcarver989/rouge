#!/usr/bin/env bash
set -euo pipefail

example="$1"
package="$2"
sdk="${ANDROID_HOME:?set ANDROID_HOME to the Android SDK}"
tools="$(find "$sdk/build-tools" -mindepth 1 -maxdepth 1 -type d | sort -V | tail -1)"
platform="$(find "$sdk/platforms" -mindepth 1 -maxdepth 1 -type d | sort -V | tail -1)"
out="target/android/$example"
keystore="target/android/debug.keystore"

rm -rf "$out"
mkdir -p "$out/lib/arm64-v8a"
cp "target/aarch64-linux-android/debug/examples/lib$example.so" "$out/lib/arm64-v8a/"
sed -e "s/PACKAGE/$package/g" -e "s/LIBRARY/$example/g" android/AndroidManifest.xml > "$out/AndroidManifest.xml"
"$tools/aapt2" link -o "$out/unaligned.apk" --manifest "$out/AndroidManifest.xml" -I "$platform/android.jar"
(cd "$out" && zip -q -r unaligned.apk lib)
"$tools/zipalign" -f -p 4 "$out/unaligned.apk" "$out/$example.apk"
if [ ! -f "$keystore" ]; then
    keytool -genkeypair -keystore "$keystore" -storepass android -keypass android -alias debug \
        -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=Rouge Debug"
fi
"$tools/apksigner" sign --ks "$keystore" --ks-pass pass:android --key-pass pass:android "$out/$example.apk"
echo "$out/$example.apk"
