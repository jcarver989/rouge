#!/usr/bin/env bash
set -euo pipefail
case_name=${1:-}
seconds=${2:-10}
if [[ $# -gt 2 || ! $case_name =~ ^[a-z0-9_]+(@[0-9]+)?$ || ! $seconds =~ ^[1-9][0-9]*$ ]]; then
    echo 'usage: scripts/profile <exact-case[@size]> [positive-seconds]' >&2
    exit 2
fi
target=${CARGO_TARGET_DIR:-target}
cargo build --locked --profile profiling -p rouge-bench --target-dir "$target"
mkdir -p "$target/bench"
"$target/profiling/rouge-bench" sample "$case_name" --repeat >/dev/null &
pid=$!
trap 'kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true' EXIT
sleep 1
if ! kill -0 "$pid" 2>/dev/null; then wait "$pid"; exit 1; fi
out="$target/bench/profile-$case_name"
case $(uname -s) in
    Darwin) sample "$pid" "$seconds" -file "$out.txt" ;;
    Linux) perf record -g -p "$pid" -o "$out.data" -- sleep "$seconds"
           perf report --stdio -i "$out.data" >"$out.txt" ;;
    *) echo 'scripts/profile supports macOS and Linux' >&2; exit 1 ;;
esac
if ! kill -0 "$pid" 2>/dev/null; then wait "$pid"; exit 1; fi
printf 'Call tree: %s.txt (inspect measured_frame for scored work)\n' "$out"
