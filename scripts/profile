#!/usr/bin/env bash
set -euo pipefail
scenario="${1:?usage: scripts/profile <scenario> [seconds]}"
seconds="${2:-10}"
bin="target/profiling/rouge-bench"
out="target/bench/profile-$scenario.txt"
idle='__workq_kernreturn|mach_msg2_trap|semaphore_wait_trap|__psynch_cvwait|__ulock_wait|kevent'
cargo build --profile profiling -p rouge-bench
mkdir -p target/bench
names="$("$bin" list)"
grep -qx "$scenario" <<<"$names" || { echo "no scenario is named $scenario"; exit 1; }
case "$(uname -s)" in
Darwin)
    "$bin" run "$scenario" --runs 1000000 >/dev/null 2>&1 &
    pid=$!
    trap 'kill "$pid" 2>/dev/null || true' EXIT
    sleep 1
    sample "$pid" "$seconds" -file "$out" >/dev/null 2>&1
    echo "samples by function on top of the stack, idle waits left out:"
    "$bin" demangle <"$out" >"$out.readable" && mv "$out.readable" "$out"
    awk '/^Sort by top of stack/ { on = 1; next } /^Binary Images/ { on = 0 } on' "$out" |
        grep -vE "$idle" | sed -E 's/ +\(in [^)]*\) +/  /' | head -40
    ;;
Linux)
    perf record -g -o target/bench/perf.data -- \
        timeout "$seconds" "$bin" run "$scenario" --runs 1000000 >/dev/null 2>&1 || true
    perf report -i target/bench/perf.data --stdio --no-children --percent-limit 0.5 >"$out" 2>/dev/null
    grep -vE '^#|^$' "$out" | grep -E '^ +[0-9.]+%' | head -40
    ;;
*)
    echo "scripts/profile supports macOS and Linux"
    exit 1
    ;;
esac
echo "full call tree: $out"
